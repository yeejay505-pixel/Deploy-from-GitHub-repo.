        880,
        0
      ],
      "parameters": {
        "jsCode": "const j=$input.first().json;if(j.handoff.schema_version!=='intake-receipt.v1'||j.handoff.accepted!==true||j.handoff.release_eligible!==false||!j.event_id||!j.handoff.benchmark_sha256||j.config.base_url.includes('REPLACE')||!j.config.base_url.startsWith('https://')||!Number.isInteger(j.config.max_polls)||j.config.max_polls<1||j.config.max_polls>120)throw Error('Stored accepted draft and configured HTTPS host required.');j.config.base_url=j.config.base_url.replace(/\\/$/,'');return [{json:j}];"
      }
