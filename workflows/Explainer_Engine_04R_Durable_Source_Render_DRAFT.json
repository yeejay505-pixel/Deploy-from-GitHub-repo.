        "jsCode": "const r=$input.first().json,c=$items('Check Render Configuration')[0].json;const receipt=r.receipt;const complete=r.status==='completed_review'&&receipt?.schema_version==='render-review-receipt.v1'&&receipt.event_id===c.event_id&&receipt.benchmark_sha256===c.handoff.benchmark_sha256&&receipt.technical_qc==='pass'&&receipt.release_eligible===false;return [{json:{event_id:c.event_id,state:r,poll_count:$runIndex+1,complete,pending:r.ok===true&&['queued','running'].includes(r.status)&&$runIndex+1<=c.config.max_polls,release_eligible:false}}];"
