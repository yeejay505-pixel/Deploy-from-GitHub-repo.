    {
      "id": "example-handoff",
      "name": "Example Handoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{schema_version:'intake-handoff.v1',idempotency_key:'FIXTURE_ONLY_NOT_A_STORED_EVENT',job_id:'fixture',release_eligible:false}}];"
      }
    },
    {
      "id": "when-executed-by-gateway",
      "name": "When Executed By Gateway",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        240
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "configure-adapter",
      "name": "Configure Adapter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        120
      ],
      "parameters": {
        "jsCode": "const items=$input.all();if(items.length!==1)throw Error('One handoff per execution required.');return items.map(i=>({json:{handoff:i.json,event_id:i.json.idempotency_key,config:{\"enabled\":false,\"base_url\":\"https://REPLACE_WITH_EXISTING_RENDERER_HOST\",\"render_enabled\":false,\"render_workflow_id\":\"\"}}}));"
      }
    },
    {
      "id": "adapter-enabled",
      "name": "Adapter Enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Adapter Enabled",
              "leftValue": "={{ $json.config.enabled === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "return-dry-run",
      "name": "Return Dry Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        320
      ],
      "parameters": {
        "jsCode": "return [{json:{dry_run:true,adapter:'source-aware-intelligence',calls_performed:false,receipt:null,release_eligible:false,next:'Deploy and bind the intake API; select a server-side model and credential before enabling.'}}];"
      }
    },
    {
      "id": "check-adapter-configuration",
      "name": "Check Adapter Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const j=$input.first().json;if(j.handoff.schema_version!=='intake-handoff.v1'||!j.event_id||j.config.base_url.includes('REPLACE')||!j.config.base_url.startsWith('https://'))throw Error('Stored handoff and configured HTTPS host required.');j.config.base_url=j.config.base_url.replace(/\\/$/,'');return [{json:j}];"
      }
    },
    {
      "id": "prepare-stored-source-plan",
      "name": "Prepare Stored Source Plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $items('Check Adapter Configuration')[0].json.config.base_url + '/intake/jobs/' + encodeURIComponent($items('Check Adapter Configuration')[0].json.event_id) + '/intelligence/prepare' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "plan-prepared",
      "name": "Plan Prepared",
      "type": "n8n-nodes-base.if",
