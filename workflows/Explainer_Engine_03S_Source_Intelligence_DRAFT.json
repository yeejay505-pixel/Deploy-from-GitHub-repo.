      "parameters": {
        "jsCode": "const r=$input.first().json;if(r.receipt?.schema_version==='intake-receipt.v1')return [{json:r.receipt}];return [{json:{status:r.status||'review_required',reason:r.error||r.reason||null,receipt:null,release_eligible:false}}];"
      }
