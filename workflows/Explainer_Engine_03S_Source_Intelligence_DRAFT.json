      "typeVersion": 2.2,
      "position": [
        2640,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Durable Render Bound",
              "leftValue": "={{ $json.status === 'validated_draft' && $items('Check Adapter Configuration')[0].json.config.render_enabled === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
